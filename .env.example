# ⚡ Smart EV Charging Station System - Environment Configuration

# 🗄️ Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 🔗 Database Connection String (for ASP.NET Core)
DATABASE_CONNECTION_STRING=Host=db.your-project.supabase.co;Database=postgres;Username=postgres;Password=your-password;Port=5432;SSL Mode=Require;Trust Server Certificate=true

# 🧠 AI Configuration (Groq API)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# 🔐 JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ISSUER=evcharging-api
JWT_AUDIENCE=evcharging-client
JWT_EXPIRY_MINUTES=120

# 👤 Bootstrap Admin Account
BOOTSTRAP_ADMIN_EMAIL=admin123@gmail.com

# 🌐 CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 🗺️ Map Configuration (OpenStreetMap - No API Key Required)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# 🚀 API Configuration
API_BASE_URL=http://localhost:5183/api
WEB_BASE_URL=http://localhost:5173

# 📝 Notes:
# - Copy this file to .env and fill in your actual values
# - Never commit .env file to version control
# - Generate secure JWT secret: openssl rand -base64 64
# - Get Groq API key from: https://console.groq.com
# - Get Supabase credentials from: https://supabase.com/dashboard
